    "test:all": "node test/e2e.mjs && node test/deep.mjs && node test/api.mjs && node test/mobile.mjs",
    "test:api": "node test/api.mjs",
    "test:mobile": "node test/mobile.mjs"
  },
  "devDependencies": {
    "playwright": "^1.56.0"
  },
  "license": "MIT",
  "main": "index.js",
  "bin": {
    "illy": "bin/illy.js"
  },
  "files": [
    "bin",
    "css",
    "docs",
    "examples",
    "index.html",
    "index.js",
    "src"
  ],
  "keywords": [
    "vector",
    "svg",
    "illustrator",
    "editor",
    "automation",
    "agent",
    "ai-tools"
  ]
